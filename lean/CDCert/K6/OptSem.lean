/-- The mask over `copy1` of an option, shifted by 64. -/
def mkS1 (d : OptD) : Nat := Nat.shiftLeft (maskOf copy1 d.toOpt) 64
/-- The mask over `copy3` of an option, shifted by 64. -/
def mkS3 (d : OptD) : Nat := Nat.shiftLeft (maskOf copy3 d.toOpt) 64

theorem wf_law {a b c : Nat} (l : Fin 3 × Fin 3) (h : a < b ∧ b < c ∧ c < 7) : (OptD.law a b c l).WF := h
theorem wf_pr {a b : Nat} (h : a < 7 ∧ b < 7 ∧ a ≠ b) : (OptD.pr a b).WF := h
theorem wf_top : OptD.top.WF := trivial

theorem maskOf_congr' {α : Type} : ∀ (base : List α) (p q : α → Bool), (∀ x, x ∈ base → p x = q x) →
    maskOf base p = maskOf base q
  | [], _, _, _ => rfl
  | x :: xs, p, q, h => by
    show 2 * maskOf xs p + (if p x then 1 else 0) = 2 * maskOf xs q + (if q x then 1 else 0)
    rw [maskOf_congr' xs p q (fun y hy => h y (List.mem_cons_of_mem _ hy)), h x List.mem_cons_self]

theorem mkS1_eq {d : OptD} (hd : d.WF) {c : Nat} (hc : codeOf d = c) :
    Nat.shiftLeft (maskOfK cm7_0 c) 64 = mkS1 d := by
  rw [← hc, maskOfK_eq hd, cm7_0_eq, maskOfN_map]
  unfold mkS1
  rw [maskOf_congr' copy1 (fun M => evalD d (cmpOf M)) d.toOpt (fun M hM => evalD_cmpOf hd (mem_copy1.mp hM))]

theorem mkS3_eq {d : OptD} (hd : d.WF) {c : Nat} (hc : codeOf d = c) :
    Nat.shiftLeft (maskOfK cm7_2 c) 64 = mkS3 d := by
  rw [← hc, maskOfK_eq hd, cm7_2_eq, maskOfN_map]
  unfold mkS3
  rw [maskOf_congr' copy3 (fun M => evalD d (cmpOf M)) d.toOpt (fun M hM => evalD_cmpOf hd (mem_copy3.mp hM))]

