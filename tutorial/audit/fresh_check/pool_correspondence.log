def Condorcet.Order.{u_1} : Type u_1 → Type (max 0 u_1) :=
fun α => { r // Condorcet.IsStrictTotal r }
def Condorcet.IsStrictTotal.{u_1} : {α : Type u_1} → (α → α → Bool) → Prop :=
fun {α} r =>
  (∀ (a : α), r a a = false) ∧
    (∀ (a b c : α), r a b = true → r b c = true → r a c = true) ∧ ∀ (a b : α), a ≠ b → r a b = true ∨ r b a = true
def Condorcet.majority.{u_1} : {α : Type u_1} → {m : ℕ} → (Fin m → Condorcet.Order α) → α → α → Prop :=
fun {α} {m} v a b => 2 * {i | ↑(v i) a b = true}.card > m
def Condorcet.IsCondorcet.{u_1} : {α : Type u_1} → Condorcet.Domain α → Prop :=
fun {α} D =>
  ∀ (m : ℕ), Odd m → ∀ (v : Fin m → Condorcet.Order α), (∀ (i : Fin m), v i ∈ D) → Transitive (Condorcet.majority v)
def Condorcet.Never.{u_1} : {α : Type u_1} → Condorcet.Order α → α → α → α → Fin 3 → Prop :=
fun {α} r x y z position =>
  if position = 0 then ↑r x y = false ∨ ↑r x z = false
  else if position = 1 then ↑r x y = ↑r x z else ↑r x y = true ∨ ↑r x z = true
def Condorcet.ValueRestricted.{u_1} : {α : Type u_1} → Condorcet.Domain α → Prop :=
fun {α} D =>
  ∀ (a b c : α),
    a ≠ b →
      a ≠ c →
        b ≠ c →
          ∃ p,
            (∀ r ∈ D, Condorcet.Never r a b c p) ∨
              (∀ r ∈ D, Condorcet.Never r b a c p) ∨ ∀ r ∈ D, Condorcet.Never r c a b p
def Condorcet.ExtremeRestricted.{u_1} : {α : Type u_1} → Condorcet.Domain α → Prop :=
fun {α} D =>
  ∀ (a b c : α),
    a ≠ b →
      a ≠ c →
        b ≠ c →
          ∃ p,
            p ≠ 1 ∧
              ((∀ r ∈ D, Condorcet.Never r a b c p) ∨
                (∀ r ∈ D, Condorcet.Never r b a c p) ∨ ∀ r ∈ D, Condorcet.Never r c a b p)
def Condorcet.IsPeakPit.{u_1} : {α : Type u_1} → Condorcet.Domain α → Prop :=
fun {α} D => Condorcet.IsCondorcet D ∧ Condorcet.ExtremeRestricted D
def Condorcet.f : ℕ → ℕ :=
fun n => (Finset.filter Condorcet.IsCondorcet Finset.univ).sup Finset.card
def Condorcet.h : ℕ → ℕ :=
fun n => (Finset.filter Condorcet.IsPeakPit Finset.univ).sup Finset.card
def Condorcet.IsMaximal.{u_1} : {α : Type u_1} → Condorcet.Domain α → Prop :=
fun {α} D => Condorcet.IsCondorcet D ∧ ∀ (E : Condorcet.Domain α), Condorcet.IsCondorcet E → D ⊆ E → E = D
def Condorcet.IsFull : {n : ℕ} → Condorcet.Domain (Fin n) → Prop :=
fun {n} D => ∃ L, D = Condorcet.fullDomain L
def Condorcet.IsExtremeFull : {n : ℕ} → Condorcet.Domain (Fin n) → Prop :=
fun {n} D => ∃ L Q, D = Condorcet.extremeFullDomain L Q
def Condorcet.InF : {n : ℕ} → Condorcet.Domain (Fin n) → Prop :=
fun {n} D => Finset.Nonempty D ∧ Condorcet.IsExtremeFull D
def CDCert.K6.IsDom : ℕ → (List ℕ → Bool) → Prop :=
fun k p =>
  ∃ c, CDCert.IsChoice c (CDCert.ListOrder.groupsEP k) ∧ ∀ L ∈ CDCert.Examples.orders k, p L = CDCert.allows c L
def CDCert.K6.DomE : ℕ → (List ℕ → Bool) → Prop :=
fun k p => CDCert.K6.IsDom k p ∨ CDCert.K6.IsEmptyOn k p
def CDCert.K6.qD : (List ℕ → Bool) → ℤ :=
fun H => CDCert.K6.bD H + CDCert.K6.tD H + CDCert.K6.pD H
def CDCert.K6.cost10 : (List ℕ → Bool) → ℕ :=
fun J =>
  CDCert.K6.adjAt 7 0 J + 2 * CDCert.K6.adjAt 7 1 J + 2 * CDCert.K6.adjAt 7 2 J + 2 * CDCert.K6.adjAt 7 3 J +
      2 * CDCert.K6.adjAt 7 4 J +
    CDCert.K6.adjAt 7 5 J
