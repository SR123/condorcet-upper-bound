'Condorcet.gapCount' depends on axioms: [propext, Classical.choice, Quot.sound]
def Condorcet.gapCount : {n : ℕ} → Condorcet.Domain (Fin (n + 1)) → ℕ :=
fun {n} D =>
  ∑ x,
    ∑ P ∈ Condorcet.deleteDomain x D, Condorcet.SlotWord.gaps (Condorcet.insertionWord (Condorcet.optionDomain x D) P)
Condorcet.h : ℕ → ℕ
'Condorcet.h' depends on axioms: [propext, Classical.choice, Quot.sound]
def Condorcet.h : ℕ → ℕ :=
fun n => (Finset.filter Condorcet.IsPeakPit Finset.univ).sup Finset.card
