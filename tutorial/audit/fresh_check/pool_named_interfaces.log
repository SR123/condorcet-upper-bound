@Condorcet.insertionSlots : {α : Type u_1} →
  [inst : Fintype α] → Condorcet.Domain (Option α) → Condorcet.Order α → Finset (Fin (Fintype.card α + 1))
'Condorcet.insertionSlots' depends on axioms: [propext, Classical.choice, Quot.sound]
def Condorcet.insertionSlots.{u_1} : {α : Type u_1} →
  [inst : Fintype α] → Condorcet.Domain (Option α) → Condorcet.Order α → Finset (Fin (Fintype.card α + 1)) :=
fun {α} [Fintype α] D P => {t | P.insertAt t ∈ D}
@Condorcet.insertionWord : {α : Type u_1} → [Fintype α] → Condorcet.Domain (Option α) → Condorcet.Order α → List Bool
'Condorcet.insertionWord' depends on axioms: [propext, Classical.choice, Quot.sound]
def Condorcet.insertionWord.{u_1} : {α : Type u_1} →
  [Fintype α] → Condorcet.Domain (Option α) → Condorcet.Order α → List Bool :=
fun {α} [Fintype α] D P => List.ofFn fun t => decide (t ∈ Condorcet.insertionSlots D P)
