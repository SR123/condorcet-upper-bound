@Condorcet.lockedCount : {n : ℕ} → Condorcet.Domain (Fin (n + 1)) → ℕ
'Condorcet.lockedCount' depends on axioms: [propext, Classical.choice, Quot.sound]
def Condorcet.lockedCount : {n : ℕ} → Condorcet.Domain (Fin (n + 1)) → ℕ :=
fun {n} D => ∑ r ∈ D, ∑ j, if Condorcet.Locked D r j then 1 else 0
@Condorcet.majority : {α : Type u_1} → {m : ℕ} → (Fin m → Condorcet.Order α) → α → α → Prop
'Condorcet.majority' depends on axioms: [propext, Classical.choice, Quot.sound]
def Condorcet.majority.{u_1} : {α : Type u_1} → {m : ℕ} → (Fin m → Condorcet.Order α) → α → α → Prop :=
fun {α} {m} v a b => 2 * {i | ↑(v i) a b = true}.card > m
